# Copy this file to .env and fill in values as each phase is turned on.
# Phase 1 (crawler) needs NONE of these to run.

SITE_BASE_URL=https://mytoolverse.vercel.app
MAX_PAGES=300
CRAWL_DELAY_SECONDS=0.5
USER_AGENT=MyToolVerseSEOAgent/1.0 (+https://mytoolverse.vercel.app)

